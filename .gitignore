# ===== EvoSeg: never commit weights/data/results =====
# model weights & checkpoints (any location)
*.pt
*.pth
*.safetensors
*.bin
*.onnx
*.msgpack

# training artifacts / results / logs (any location)
work_dirs/
wandb/
*.log
*.tensorboard
tensorboard/

# top-level data & model dirs ONLY (do NOT ignore nested source dirs like projects/*/datasets)
/data/
/datasets/
/outputs/
/results/
/runs/
/pretrained/
/models/
/weights/
/checkpoints/
/cache/

# caches / envs
.cache/
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
